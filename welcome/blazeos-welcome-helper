#!/usr/bin/env bash
# =============================================================================
# BlazeOS Welcome Helper - Debian/Jubatus port
# Privileged backend for blazeos-welcome wizard.
# Adapted from Fedora/DNF to Debian/APT.
# =============================================================================

set -u

if [ "$(id -u)" -ne 0 ]; then
    echo "ERR: this helper requires root" >&2
    exit 1
fi

stop_pk() {
    echo "# Stopping PackageKit temporarily (APT lock)..."
    systemctl stop packagekit.service 2>/dev/null || true
    systemctl stop packagekit-offline-update.service 2>/dev/null || true
}

ACTION="${1:-}"
shift || true

case "$ACTION" in
    update-all)
        stop_pk
        echo "# [1/3] Refreshing APT metadata..."
        apt-get update 2>&1 || true
        echo "# [2/3] Upgrading all packages (kernel + drivers included)..."
        DEBIAN_FRONTEND=noninteractive apt-get -y upgrade 2>&1
        rc=$?
        echo "# [3/3] Done. Exit code: $rc"
        exit $rc
        ;;

    update-drivers)
        stop_pk
        echo "# Upgrading kernel, firmware and graphics drivers..."
        apt-get update 2>&1 || true
        DEBIAN_FRONTEND=noninteractive apt-get -y install --only-upgrade \
            linux-image-amd64 \
            linux-headers-amd64 \
            firmware-linux \
            firmware-linux-nonfree \
            firmware-misc-nonfree \
            mesa-vulkan-drivers \
            libgl1-mesa-dri 2>&1 || true
        rc=$?
        echo "# Driver update done. Exit code: $rc"
        exit $rc
        ;;

    update-security)
        stop_pk
        echo "# Applying security updates (Debian has no separate security channel)..."
        apt-get update 2>&1 || true
        DEBIAN_FRONTEND=noninteractive apt-get -y upgrade 2>&1
        rc=$?
        echo "# Security update done. Exit code: $rc"
        exit $rc
        ;;

    update-packages)
        stop_pk
        echo "# Upgrading application packages (kernel/drivers held back)..."
        apt-get update 2>&1 || true
        # Hold kernel and firmware packages during the upgrade
        apt-mark hold linux-image-amd64 linux-headers-amd64 \
            firmware-linux firmware-linux-nonfree 2>/dev/null || true
        DEBIAN_FRONTEND=noninteractive apt-get -y upgrade 2>&1
        rc=$?
        apt-mark unhold linux-image-amd64 linux-headers-amd64 \
            firmware-linux firmware-linux-nonfree 2>/dev/null || true
        echo "# Package update done. Exit code: $rc"
        exit $rc
        ;;

    update)
        stop_pk
        echo "# Full update (backwards compatibility)..."
        apt-get update 2>&1 || true
        DEBIAN_FRONTEND=noninteractive apt-get -y upgrade 2>&1
        rc=$?
        echo "# APT exit code: $rc"
        exit $rc
        ;;

    waydroid)
        echo "# Waydroid on Debian requires the third-party Waydroid repo."
        echo "# This is intentionally NOT automated to keep the wizard single-pkexec."
        echo "# To install manually:"
        echo "#   curl -s https://repo.waydro.id | sudo bash"
        echo "#   sudo apt install waydroid"
        echo "# Skipping Waydroid setup."
        exit 0
        ;;

    install-de)
        if [ "$#" -eq 0 ]; then
            echo "ERR: no packages specified" >&2
            exit 2
        fi
        stop_pk
        echo "# Installing: $*"
        DEBIAN_FRONTEND=noninteractive apt-get -y install "$@" 2>&1
        rc=$?
        echo "# APT exit code: $rc"
        exit $rc
        ;;

    remove-gnome)
        # Debian port: safety-guarded GNOME removal.
        # On Jubatus, GNOME is not installed by default, so this is a no-op.
        if ! dpkg -l | grep -q '^ii.*gnome-shell'; then
            echo "# GNOME Shell is not installed. Nothing to remove."
            exit 0
        fi
        echo "# Removing GNOME Shell packages..."
        DEBIAN_FRONTEND=noninteractive apt-get -y remove \
            gnome-shell gnome-session gnome-shell-extensions \
            gnome-classic 2>&1 || true
        echo "# GNOME removed."
        exit 0
        ;;

    set-dock)
        echo "# Dock management is GNOME-specific and not applicable on Niri/SolarUI."
        echo "# Skipping."
        exit 0
        ;;

    *)
        echo "ERR: unknown action: $ACTION" >&2
        echo "Usage: blazeos-welcome-helper {update-all|update-drivers|update-security|update-packages|update|waydroid|install-de <pkgs>|remove-gnome <DE>|set-dock <none|dash-to-dock>}" >&2
        exit 64
        ;;
esac
